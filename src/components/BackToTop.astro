---
// Badge fixa "voltar ao topo" — aparece só na intenção de voltar (scroll
// pra cima, longe do topo), não simplesmente "depois de X px". Mesmo
// vidro/reflexo diagonal dos outros botões do sistema, mesmo Lenis
// compartilhado (window.__lenis) que o NavRail já usa pro scroll suave.
---

<button type="button" id="back-to-top" class="back-to-top" aria-label="Voltar ao topo">
  <span class="dot" aria-hidden="true"></span>
  <span class="label">WPBuilder</span>
  <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <path d="M6 15l6-6 6 6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    top: 22px;
    left: 50%;
    z-index: 80;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px 10px 14px;
    border-radius: 999px;
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.14));
    background-color: var(--panel-bg, rgba(26, 22, 18, 0.85));
    background-image: var(--glass-sheen, none);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    backdrop-filter: blur(20px) saturate(160%);
    box-shadow: var(--glass-highlight, inset 0 1px 0 rgba(255, 255, 255, 0.16)),
      var(--pill-shadow, 0 12px 28px -18px rgba(0, 0, 0, 0.5));
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;

    /* estado oculto por padrão — some pra cima da tela */
    transform: translate(-50%, -140%);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.5s ease, box-shadow 0.5s ease;
  }
  .back-to-top.is-visible {
    transform: translate(-50%, 0);
    opacity: 1;
    pointer-events: auto;
  }

  .back-to-top:focus-visible {
    outline: 2px solid var(--accent-300);
    outline-offset: 3px;
  }

  .back-to-top .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent-300);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-300) 20%, transparent);
    animation: pulse-soft 2.6s ease-in-out infinite;
  }

  .back-to-top .chevron {
    width: 14px;
    height: 14px;
    color: var(--accent-300);
    animation: float-up 1.6s ease-in-out infinite;
  }
  @keyframes float-up {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  /* mesmo reflexo diagonal dos botões de vidro do sistema */
  .back-to-top::before {
    content: '';
    position: absolute;
    z-index: 2;
    inset: -60% -80%;
    background: linear-gradient(115deg, transparent 42%, rgba(255, 255, 255, 0.5) 50%, transparent 58%);
    transform: translateX(-65%);
    transition: transform 1s ease;
    pointer-events: none;
  }
  .back-to-top:hover::before {
    transform: translateX(65%);
  }
  .back-to-top:hover {
    border-color: rgba(255, 255, 255, 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: opacity 0.3s ease;
      transform: translate(-50%, 0) !important;
    }
    .back-to-top .dot,
    .back-to-top .chevron {
      animation: none;
    }
    .back-to-top::before {
      display: none;
    }
  }
</style>

<script>
  interface LenisLike {
    scrollTo: (target: number, opts?: Record<string, unknown>) => void;
  }

  const btn = document.getElementById('back-to-top');
  const SHOW_THRESHOLD = 500;
  let lastY = window.scrollY;
  let ticking = false;

  function handleScroll() {
    ticking = false;
    if (!btn) return;

    const currentY = window.scrollY;
    const scrollingUp = currentY < lastY;
    const pastThreshold = currentY > SHOW_THRESHOLD;

    btn.classList.toggle('is-visible', scrollingUp && pastThreshold);
    lastY = currentY;
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(handleScroll);
      }
    },
    { passive: true }
  );

  btn?.addEventListener('click', () => {
    const sharedLenis = (window as unknown as { __lenis?: LenisLike }).__lenis;
    if (sharedLenis) {
      sharedLenis.scrollTo(0, { duration: 1.2 });
    } else {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });
</script>
