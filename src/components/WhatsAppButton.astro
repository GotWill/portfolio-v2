---
// Botão fixo de WhatsApp — logo abaixo do ThemeToggle (top:20px, 52px,
// z-index:80), visível só em desktop. Visual autoral (glifo genérico de
// chat, não o logo oficial da marca), mesmo vidro/pulso do resto do
// sistema — node-pulse já existe em TiltGlow.astro, reaproveitado por
// nome (Astro não escopa @keyframes).
const WHATSAPP_URL = 'https://wa.me/5511965239222';
---

<a
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener noreferrer"
  class="whatsapp-widget"
  aria-label="Conversar no WhatsApp"
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M12 2C6.48 2 2 6.36 2 11.7c0 1.87.55 3.62 1.5 5.11L2.5 22l5.4-1.42a10.4 10.4 0 0 0 4.1.84c5.52 0 10-4.36 10-9.72S17.52 2 12 2Zm0 17.6c-1.42 0-2.75-.38-3.9-1.04l-.28-.16-3.2.84.86-3.1-.18-.3A7.9 7.9 0 0 1 4 11.7C4 7.46 7.58 4 12 4s8 3.46 8 7.7-3.58 7.9-8 7.9Zm4.4-5.93c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1-.37-1.9-1.17-.7-.62-1.18-1.4-1.32-1.64-.14-.24-.02-.37.1-.49.1-.1.24-.26.36-.4.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.4h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.1.16 1.52.1.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"
    ></path>
  </svg>
</a>

<style>
  .whatsapp-widget {
    position: fixed;
    top: 86px;
    right: 20px;
    z-index: 74;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.14));
    background-color: var(--panel-bg, rgba(26, 22, 18, 0.8));
    background-image: var(--glass-sheen, none);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    box-shadow: var(--glass-highlight, inset 0 1px 0 rgba(255, 255, 255, 0.16)),
      var(--pill-shadow, 0 12px 28px -18px rgba(0, 0, 0, 0.5));
    color: var(--text);
    text-decoration: none;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  @media (max-width: 768px) {
    .whatsapp-widget {
      display: none;
    }
  }

  .whatsapp-widget svg {
    width: 22px;
    height: 22px;
  }
  .whatsapp-widget:hover {
    color: var(--accent-300);
    border-color: rgba(255, 255, 255, 0.3);
  }
  .whatsapp-widget:focus-visible {
    outline: 2px solid var(--accent-300);
    outline-offset: 3px;
  }

  /* anel de pulso contínuo — sinal discreto de disponibilidade, pausa no
     hover pra não competir com o feedback de cor do ícone */
  .whatsapp-widget::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 999px;
    border: 1px solid var(--accent-300);
    opacity: 0;
    animation: node-pulse 3.2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  .whatsapp-widget:hover::after {
    animation-play-state: paused;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-widget::after {
      animation: none;
    }
  }
</style>
